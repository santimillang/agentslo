{
  "uid": "agentslo",
  "title": "agentslo: agent reliability",
  "tags": [
    "agentslo",
    "genai"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Health now",
      "description": "Health score per agent, 0 (on fire) to 100. Combines burn rate, tool errors and loops.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['gen_ai.agent.name'] AS agent, argMax(Value, TimeUnix) AS health\nFROM otel.otel_metrics_gauge\nWHERE MetricName = 'agentslo.health' AND $__timeFilter(TimeUnix)\nGROUP BY agent ORDER BY agent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 50
              },
              {
                "color": "#0ca30c",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^health$/"
        },
        "textMode": "value_and_name",
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "horizontal",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Burn rate (1h) now",
      "description": "Error-budget burn over the last hour. 1x = spending exactly the budget; 14.4x pages.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['gen_ai.agent.name'] AS agent, argMax(Value, TimeUnix) AS burn\nFROM otel.otel_metrics_gauge\nWHERE MetricName = 'agentslo.burn_rate' AND Attributes['window'] = '1h' AND $__timeFilter(TimeUnix)\nGROUP BY agent ORDER BY agent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 6
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^burn$/"
        },
        "textMode": "value_and_name",
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "horizontal",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Health score",
      "description": "Per-agent health, 0-100.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time,\n       Attributes['gen_ai.agent.name'] AS agent,\n       avg(Value) AS health\nFROM otel.otel_metrics_gauge\nWHERE MetricName = 'agentslo.health' AND $__timeFilter(TimeUnix) \nGROUP BY time, agent\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "displayName": "${__field.labels.agent}",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "support-bot"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "research-agent"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Burn rate (1h window)",
      "description": "Error rate / error budget. Dashed lines: 1x (on budget) and 14.4x (fast-burn page).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time,\n       Attributes['gen_ai.agent.name'] AS agent,\n       avg(Value) AS burn\nFROM otel.otel_metrics_gauge\nWHERE MetricName = 'agentslo.burn_rate' AND $__timeFilter(TimeUnix) AND Attributes['window'] = '1h'\nGROUP BY time, agent\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "displayName": "${__field.labels.agent}",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "support-bot"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "research-agent"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tool error ratio",
      "description": "Failed tool calls / tool calls (since last eviction).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time,\n       Attributes['gen_ai.agent.name'] AS agent,\n       avg(Value) AS ratio\nFROM otel.otel_metrics_gauge\nWHERE MetricName = 'agentslo.tool.error_ratio' AND $__timeFilter(TimeUnix) \nGROUP BY time, agent\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "displayName": "${__field.labels.agent}",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "support-bot"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "research-agent"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sessions with a loop",
      "description": "Share of sessions where a loop pattern tripped.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time,\n       Attributes['gen_ai.agent.name'] AS agent,\n       avg(Value) AS ratio\nFROM otel.otel_metrics_gauge\nWHERE MetricName = 'agentslo.loop.session_ratio' AND $__timeFilter(TimeUnix) \nGROUP BY time, agent\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "displayName": "${__field.labels.agent}",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "support-bot"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "research-agent"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Loop events by kind",
      "description": "Cumulative count at the end of the selected range; resets when the collector restarts (agentslo.loop.events).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['kind'] AS kind, toFloat64(argMax(Value, TimeUnix)) AS events\nFROM otel.otel_metrics_sum\nWHERE MetricName = 'agentslo.loop.events' AND $__timeFilter(TimeUnix)\nGROUP BY kind ORDER BY kind"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#c3c2b7"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "kind"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "repeat": {
                        "color": "#199e70",
                        "index": 0
                      },
                      "retry_storm": {
                        "color": "#c98500",
                        "index": 1
                      },
                      "oscillation": {
                        "color": "#d55181",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "kind",
        "showValue": "always",
        "colorByField": "kind",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tasks per minute",
      "description": "invoke_agent spans per minute, from the raw traces table.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfMinute(Timestamp) AS time,\n       SpanAttributes['gen_ai.agent.name'] AS agent,\n       count() AS tasks\nFROM otel.otel_traces\nWHERE SpanAttributes['gen_ai.operation.name'] = 'invoke_agent' AND $__timeFilter(Timestamp)\n  AND Timestamp < toStartOfMinute($__toTime)  -- skip the partial last minute\nGROUP BY time, agent\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "displayName": "${__field.labels.agent}",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "support-bot"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "research-agent"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Burn-rate alerts firing",
      "description": "Multi-window burn-rate rules currently or recently firing (agentslo.alert.firing).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['gen_ai.agent.name'] AS agent, Attributes['rule'] AS rule,\n       max(TimeUnix) AS last_seen\nFROM otel.otel_metrics_gauge\nWHERE MetricName = 'agentslo.alert.firing' AND $__timeFilter(TimeUnix)\nGROUP BY agent, rule ORDER BY last_seen DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No alerts firing"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
