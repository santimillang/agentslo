# Builds the custom collector with ocb. Context is the repo root.
FROM golang:1.26 AS build
ARG OCB_VERSION=0.164.0
RUN go install go.opentelemetry.io/collector/cmd/builder@v${OCB_VERSION}
WORKDIR /src
COPY . .
RUN builder --config builder-config.yaml

FROM gcr.io/distroless/base-debian12
COPY --from=build /src/_build/otelcol-agentslo /otelcol
COPY deploy/otelcol.yaml /etc/otelcol/config.yaml
ENTRYPOINT ["/otelcol", "--config", "/etc/otelcol/config.yaml"]
